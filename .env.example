# ---- Forum account (cookie-session login, required for most tools) ----
NODELOC_USERNAME=your_username_or_email
NODELOC_PASSWORD=your_password
# Optional, defaults shown:
# NODELOC_BASE_URL=https://www.nodeloc.com
# NODELOC_TIMEZONE=Asia/Shanghai
# NODELOC_LOCALE=zh-CN
# 0 = none, 1 = SMS, 2 = TOTP
# NODELOC_SECOND_FACTOR_METHOD=0

# ---- Official Payment app (optional, only for payment/transfer tools) ----
# Create at https://www.nodeloc.com/payment/applications (TL1+, admin approval)
# NODELOC_PAYMENT_ID=pay_xxxxxxxxxxxxxxxxxx
# NODELOC_PAYMENT_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Miniprogram CLI (optional, only for apps tools) ----
# NODELOC_APPS_CLI=nodeloc-apps

# ---- Data dir for session/docs cache (optional) ----
# NODELOC_DATA_DIR=~/.nodeloc-mcp
